{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "figma-feedback.config.json",
  "type": "object",
  "required": ["devServer", "viewport", "figma", "routes"],
  "properties": {
    "devServer": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "waitFor": {
          "oneOf": [
            { "const": "networkidle" },
            { "const": "load" },
            { "const": "domcontentloaded" }
          ]
        }
      }
    },
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width":  { "type": "integer", "minimum": 200 },
        "height": { "type": "integer", "minimum": 200 }
      }
    },
    "figma": {
      "type": "object",
      "required": ["fileKey", "changelogPageName"],
      "properties": {
        "fileKey":           { "type": "string", "minLength": 1 },
        "changelogPageName": { "type": "string", "minLength": 1 }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "path"],
        "properties": {
          "label":   { "type": "string", "minLength": 1 },
          "path":    { "type": "string", "pattern": "^/" },
          "waitFor": { "type": "string" }
        }
      }
    }
  }
}
