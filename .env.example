# Figma Personal Access Token — generate at https://www.figma.com/developers/api#access-tokens
# Used by figloops TS scripts (REST image upload, REST comment fetch, init validators).
# The Figma MCP server has its own authentication, configured separately
# at the Claude Code MCP-setup level.
FIGMA_TOKEN=figd_REPLACE_ME

# Absolute path to where the figloops plugin is installed (e.g.,
# ~/.claude/plugins/figloops). The plugin's skill uses this to locate
# its TS helper scripts when running from the consuming repo.
# /figloops:init fills this in automatically.
FIGLOOPS_PLUGIN_DIR=/absolute/path/to/figloops
